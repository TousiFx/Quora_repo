<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css">
    <title>Quora Post</title>
</head>
<body>
    <h1>Quora Posts</h1>
    <% for(let post of posts) {%>
        <div class="post">
            <h3>@ <%= post.username %></h3>
            <h3><%= post.content %></h3>
    
            <a href="http://localhost:8080/posts/<%= post.id %> " id="view">View Details</a>
            <a href="http://localhost:8080/posts/<%= post.id %>/edit" id="edit">Edit</a>

             <form action="http://localhost:8080/posts/<%= post.id %>?_method=DELETE" method="post">
               <button id="btn-del">Delete</button>
             </form>
           
        </div>
    <%}%>
    
  
    <a href="http://localhost:8080/posts/new"></a>
</body>
</html>
